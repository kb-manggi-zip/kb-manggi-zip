# ── 서버 ──────────────────────────────────────────────────────────
# CORS 허용 오리진 (프론트 배포 도메인). 콤마로 여러 개.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── 데이터베이스 ─────────────────────────────────────────────────
# 로컬 데모: SQLite 파일 (아무 설정 없이 동작)
DATABASE_URL=sqlite:///./kb.db
# docker-compose(Postgres) 사용 시 compose가 아래 값을 주입:
# DATABASE_URL=postgresql+psycopg://kb:kb@db:5432/kb

# ── LLM (Phase B4) ───────────────────────────────────────────────
# 키가 없으면 모든 LLM 노드는 템플릿 폴백으로 동작 (데모 완주 가능)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
# 실제 Claude 호출을 켜려면 true (Phase B4 검증기 완성 후 권장). 기본 false.
LLM_ENABLED=false

# ── 외부 데이터 (Phase B2) ───────────────────────────────────────
# 공공데이터포털(국토부 실거래) 서비스 키
MOLIT_API_KEY=

# ── 캐시 ─────────────────────────────────────────────────────────
CACHE_DIR=./cache
CACHE_TTL_HOURS=24
